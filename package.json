{
    "name": "@ketherworks/leetcode-mcp-private",
    "description": "Private local anonymous read-only LeetCode MCP adapter",
    "version": "0.1.0",
    "private": true,
    "author": "KetherWorks",
    "main": "./build/index.js",
    "keywords": [
        "leetcode",
        "lc",
        "mcp",
        "programming",
        "algorithm"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest watch",
        "build": "tsc",
        "start": "node build/index.js",
        "dev": "tsc-watch --onSuccess \"node build/index.js\"",
        "format": "prettier --write .",
        "prepare": "husky",
        "prepack": "npm run build"
    },
    "bin": {
        "leetcode-mcp-private": "build/index.js"
    },
    "type": "module",
    "files": [
        "build/index.js",
        "build/index.d.ts",
        "build/index.js.map",
        "build/cli.*",
        "build/anonymous-service.*",
        "build/oj",
        "build/leetcode",
        "build/utils",
        "LICENSE",
        "README.md",
        "UPSTREAM.md",
        "THIRD_PARTY_NOTICES"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ketherworks/leetcode-mcp-private.git"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.{md,json,yml,yaml,html,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.29.0",
        "leetcode-query": "^2.0.0",
        "pino": "^9.6.0",
        "zod": "^3.24.2",
        "zod-to-json-schema": "^3.24.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.14.0",
        "esbuild": "^0.25.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-prettier": "^5.2.6",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.5.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "tsc-watch": "6.2.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^6.3.5",
        "vitest": "^3.1.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.40.1"
    }
}
